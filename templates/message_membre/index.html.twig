{% extends 'membres.html.twig' %}

{% block title %}Hello MessageController!{% endblock %}

{% block body %}
<style>
body {
    margin-left: 1cm;
    margin-right: 1cm;
    background-color: white;
}
    .message-container {
        display: flex;
        flex-direction: column;
        gap: 15px;
        margin: 30px auto;
        max-width: 800px;
    }

    .message-box {
        max-width: 60%;
        padding: 15px;
        border-radius: 10px;
        background-color:  #8B4513;
        position: relative;
    }
.message-scroll-zone {
    max-height: 300px; 
    margin-left: 1cm;
    margin-right: 1cm;
    background-color: white;
    overflow-y: auto;
    border: 1px solid #ccc;
    padding: 10px;
    border-radius: 10px; /* ou blanc si tu préfères */
}


    .message-left {
        align-self: flex-start;
        background-color:rgb(235, 174, 131);
    }

    .message-right {
        align-self: flex-end;
        background-color:rgb(114, 79, 55);
        color:white;
    }

    .message-author {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .message-date {
        font-size: 0.8rem;
        color: gray;
        margin-top: 5px;
        text-align: right;
    }

    .form-section {
        max-width: 500px;
        margin: 40px auto;
        padding: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        background-color: #fdfdfd;
    }
</style>

<h3 class="text-center mb-4">Messages envoyés</h3>

<!-- ✅ Zone scrollable -->
<div class="message-scroll-zone">
    <div class="message-container" id="zone-messages">
        {% if messages is empty %}
            <p>Aucun message envoyé.</p>
        {% else %}
            {% for message in messages %}
                <div class="message-box {% if message.expediteur == 'membre' %}message-right{% else %}message-left{% endif %}">
                    <div class="message-author">
                        {{ message.nom_expediteur }}
                    </div>
                    <div class="message-content">
                        {{ message.contenu }}
                    </div>
                    <div class="message-date">
                        {{ message.date_envoi }}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

{% endblock %}
