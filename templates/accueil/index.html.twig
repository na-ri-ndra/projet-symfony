                <p class="card-text">Analyse des données d'utilisation et génération de rapports</p>
            </div>
        </div>
        <div class="col">
            <div class="card h-100 p-4 text-center border-#faefeac7">
                <div class="card-img-top mx-auto mb-3" style=" color:#f7e7c9;width: 60px; height: 60px; background-color: #3f1a01ff; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <i class="bi bi-search fs-3"></i>
                </div>
