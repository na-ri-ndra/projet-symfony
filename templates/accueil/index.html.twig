</section>
<!-- Section Fonctions -->
<div class="text-center py-5" style="background: linear-gradient(to right, #3f1a01ff, #8B4513) ;margin-bottom:20px;color: white;border-radius:20px;">
    <h2 class="mb-3" style="color:white;">Prêt à moderniser votre bibliothèque ?</h2>
    <p class="text-white-50 mb-4">Rejoignez les établissements qui ont choisi Bibliôteky pour transformer leur gestion documentaire</p>
    <a href="#" class="btn btn-light rounded-pill px-4 py-2 d-inline-flex align-items-center">
        Découvrir la démonstration
        <i class="bi bi-arrow-right ms-2"></i>
    </a>
</div>    
</main>
<footer class="footer text-white mt-auto py-5">
    <div class="container">
        <div class="row">
            <!-- Nom & Description -->
            <div class="col-md-4">
            <h5>
            <img src="{{ asset('images/books.png') }}" alt="Logo Livre" width="30" height="30">
                Bibliôteky<br>Gestion Scolaire</h5>
                <p>Application web de gestion de bibliothèque physique scolaire</p>
