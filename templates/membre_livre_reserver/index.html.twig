{% extends 'membres.html.twig' %}

{% block title %}Hello MembreLivreReserverController!{% endblock %}

{% block body %}

<div class="container mt-5">
    <h1 class="mb-4">Livre reserver</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    {% if reservations_groupees is empty %}
        <p class="alert alert-info">Vous n'avez pas de réservations de livres pour le moment.</p>
        <p><a href="{{ path('membre_livres') }}" class="btn btn-primary">Faire une nouvelle réservation</a></p>
    {% else %}
        {% for reservationId, reservation in reservations_groupees %}
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-dark text-white">
                    Réservation #{{ reservation.id }}
                    <span class="badge {% if reservation.statut == 'en attente' %}bg-warning{% elseif reservation.statut == 'emprunté' %}bg-primary{% elseif reservation.statut == 'terminée' %}bg-success{% elseif reservation.statut == 'annulée' %}bg-danger{% endif %} float-end">
                        {{ reservation.statut|capitalize }}
                    </span>
                </div>
                <div class="card-body">
                    <p><strong>Date de la demande :</strong> {{ reservation.date_reservation|date('d/m/Y H:i') }}</p>
                    <p><strong>Date de retrait souhaitée :</strong> {{ reservation.date_retrait|date('d/m/Y') }}</p>
                    <h5 class="mt-3">Livres inclus dans cette réservation :</h5>
                    <ul class="list-group list-group-flush">
                        {% for livre in reservation.livres %}
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>{{ livre.titre }}</strong> par {{ livre.auteur }} (ISBN: {{ livre.isbn }})
                                    {% if livre.code_etagere %}
                                        <br><small class="text-muted">Étagère: {{ livre.code_etagere }}</small>
                                    {% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    {# Bouton d'annulation pour les réservations en attente #}
                    {% if reservation.statut == 'en attente' %}
                        <div class="mt-3">
                            <form action="{{ path('app_membre_annuler_reservation', {id: reservation.id}) }}" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette réservation ?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Annuler la réservation</button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    {% endif %}
</div>

{% endblock %}
